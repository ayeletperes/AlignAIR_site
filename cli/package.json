{
  "name": "@alignair/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line interface for AlignAIR — reuses the site's TS inference pipeline natively in Node.",
  "bin": {
    "alignair": "./dist/index.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node --transpile-only src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "onnxruntime-node": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
